Options -Indexes
RewriteEngine On

# Code et données jamais accessibles depuis le web
RewriteRule ^(app|data)(/|$) - [F,L]
RewriteRule ^(README\.md|\.git) - [F,L]

# La redirection HTTPS est gérée par Hostinger (réglage « Forcer HTTPS »)
RewriteRule ^\.well-known/ - [L]

# Tout passe par index.php sauf les fichiers existants (CSS, images...)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
